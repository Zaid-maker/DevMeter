# Required
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DEV_ADMIN_SECRET=
DEVMETER_APP_URL=http://localhost:3000/api

# Optional
DISCORD_SYNC_WINDOW_DAYS=7
DISCORD_SYNC_INTERVAL_MS=300000
DISCORD_DRY_RUN=true

# Auto-create roles in Discord guild if they don't exist
# JSON array: [{"name":"Bronze","color":"#CD7F32","hoist":true},{"name":"Silver","color":"#C0C0C0"}]
# Bot will log the created role IDs on startup - use them in DISCORD_ROLE_RULES
DISCORD_ROLES=[]

# JSON array of role eligibility rules.
# Example:
# [{"name":"Bronze","roleId":"1234567890","minHours":5},{"name":"Silver","roleId":"1234567891","minHours":20,"minLevel":2}]
DISCORD_ROLE_RULES=[]
